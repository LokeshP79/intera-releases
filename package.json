{
  "name": "interai-desktop",
  "version": "1.3.2",
  "private": true,
  "description": "InterAI interview conversation assistant",
  "main": "main.js",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "dist:win": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.interai.app",
    "productName": "InterAI",
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "InterAI captures meeting playback audio to transcribe interviewer questions.",
        "NSAudioCaptureUsageDescription": "InterAI transcribes meeting playback audio to detect interviewer questions.",
        "NSMicrophoneUsageDescription": "InterAI optionally transcribes your microphone for conversation context. Your microphone does not trigger answers."
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "package.json",
      "README.md"
    ]
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22"
  }
}
